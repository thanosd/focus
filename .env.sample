# ── Backend (backend/.env for local dev) ─────────────────────────────
# PostgreSQL connection string. The devcontainer's Postgres listens on 5403.
DATABASE_URL=postgres://postgres:rootpassword@localhost:5403/focus?sslmode=disable

# Comma-separated list of browser origins allowed to call the API.
BACKEND_CORS_ORIGINS=http://localhost:3000

# Where the API redirects after Google sign-in completes.
FRONTEND_URL=http://localhost:3000

# Public URL of this API (used to build the Google OAuth redirect URL).
API_URL=http://localhost:8000

# Google OAuth 2.0 web client (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI must be ${API_URL}/api/auth/google/callback.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Only these Google accounts may sign in (comma-separated, case-insensitive).
AUTH_ALLOWED_EMAILS=you@example.com

# Random 32+ byte secret for the CSRF middleware (openssl rand -base64 32).
CSRF_AUTH_KEY=change-me

# Claude API key — powers the natural-language defer/due date parser.
# The rule-based parser handles common phrases without it; the AI
# fallback is disabled when this is empty.
CLAUDE_API_KEY=sk-ant-...
# Optional: override the model used for date parsing.
CLAUDE_MODEL=claude-opus-5

# Temporal (worker + server). The devcontainer's Temporal listens on 7234.
TEMPORAL_HOST=localhost:7234
TEMPORAL_NAMESPACE=focus

ENVIRONMENT=development

# ── Frontend (frontend/.env.local) ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
